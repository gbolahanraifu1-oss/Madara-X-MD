
# NOTE: this file is a smaller, older duplicate of .env.example — use
# .env.example instead, it documents every variable the bot actually reads
# (including OWNER_NUMBER, which is NOT in this file and is required for
# .exec/.allvars/.getfile/.shutdown/.anticall to be gated to you).

# ── SILVA AUTO-FEATURES ────────────────────────────────────────────────────────
WELCOME_MSG=true
GOODBYE_MSG=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_BIO=false
AUTO_REACT=false
ALWAYS_ONLINE=false
ANTI_CALL=false
ANTI_LINK=false
ANTI_BAD_WORD=false
ANTI_SPAM=false
CHATBOT=false
