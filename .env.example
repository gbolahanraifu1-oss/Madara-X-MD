# ╔═══════════════════════════════════════════╗
# ║  MADARA X-MD — .env EXAMPLE                ║
# ╚═══════════════════════════════════════════╝
# Copy this file to `.env` (not sample.env — that one's an older, smaller
# duplicate of this file kept only for backwards compat) and fill in your
# own values. Anything left blank/unset falls back to a default in
# settings.js — for most vars that's fine, but OWNER_NUMBER below is the
# one you MUST set yourself.

# ── ⚠️ OWNER_NUMBER — READ THIS ─────────────────────────────────────────
# This is THE variable that gates every sensitive command: .exec, .allvars,
# .getfile, .shutdown, .anticall, and every plain "owner only" command too.
# If you leave this blank, the bot falls back to a hardcoded placeholder
# number baked into settings.js — NOT your number — and whoever owns that
# placeholder number effectively has full owner access to your bot.
# Format: country code + number, no + no spaces, e.g. 2347062301699
OWNER_NUMBER=

# Owner's WhatsApp number shown in the Telegram bot's "Contact Owner"
# button/reports — cosmetic only, does NOT gate any command. Separate
# from OWNER_NUMBER above; set both to your own number.
OWNER_WHATSAPP=

# Optional — bot-wide sudo/vendor number that should pass ownerOnly (but
# NOT devOnly) checks. Falls back to OWNER_NUMBER if unset.
# VENDOR_NUMBER=

# ── TELEGRAM SETUP ──────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@YourChannelUsername   # Users must join this channel before the bot unlocks. Use @username for public channels or a full invite link for private ones. Leave blank to disable the gate.
TELEGRAM_GROUP_ID=-1001234567890           # Telegram group where users can pair via /pair command. Bot must be admin. Leave blank to disable group pairing.
PAIR_GROUP_JID=                            # WhatsApp group JID mirrored for pairing notices, if used.

# Telegram user IDs (comma-separated, no spaces) — controls the Telegram
# admin panel (lib/telegram.js), separate from OWNER_NUMBER/WhatsApp above.
OWNER_ID=123456789,987654321
ADMIN_ID=111111111,222222222

# ── WHATSAPP CHANNEL & GROUP ────────────────
WA_CHANNEL_ID=1234567890
WA_GROUP_INVITE=https://chat.whatsapp.com/YOUR_GROUP_LINK
CHANNEL_LINK=
NEWSLETTER_JID=

# Telegram channel/group/tutorial links surfaced in bot menus, if used
TG_CHANNEL_1_URL=
TG_CHANNEL_2_URL=
TG_GROUP_URL=
TG_TUTORIAL_URL=

# ── BOT SETTINGS ────────────────────────────
BOT_NAME=MADARA X-MD
OWNER_NAME=
PREFIX=.
PREFIXES=                # optional comma-separated list of extra prefixes
COMMAND_MODE=public       # public | private
NO_PREFIX_MODE=false
BOT_URL=
PORT=3000
WEB_PORT=

# ── SILVA / MADARA AUTO-FEATURES ────────────────────────────────────────
WELCOME_MSG=true
GOODBYE_MSG=true
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_BIO=false
ALWAYS_ONLINE=false
ANTI_CALL=false            # legacy default — overridden at runtime by .anticall on/off
REJECTSCALLS=              # 'truemsg' = send a rejection text, blank = silent reject
CALLMSG=                   # custom anti-call rejection message

# ── API KEYS (only needed for the features that use them) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEFAULT_AI_PROVIDER=grok
# Optional model overrides:
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# XAI_MODEL=grok-3-mini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GIPHY_API_KEY=
WEATHER_API_KEY=
REMOVEBG_API_KEY=
REMOVEBG_KEY=
TIKTOK_PAGE=
